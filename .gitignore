# zsh runtime artifacts (regenerated on every shell start)
zsh/.config/zsh/.zcompdump*
zsh/.config/zsh/.zcompcache/
zsh/.config/zsh/.zsh_sessions/

# plugin manager clones — self-bootstrapping, not source
zsh/.config/zsh/plugins/
tmux/.config/tmux/plugins/
yazi/.config/yazi/flavors/
yazi/.config/yazi/plugins/

# secrets — API keys and tokens, never version-controlled.
# The globs end in .zsh, so secrets.zsh.example stays tracked as the template.
**/secrets.zsh
**/*.secret.zsh
*.env
.env*
**/*.key
**/*.pem

# macOS
.DS_Store
