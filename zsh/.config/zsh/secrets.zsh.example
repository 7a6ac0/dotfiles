# ~/.config/zsh/secrets.zsh.example
#
# Template for API keys and tokens. Copy it into place on a new machine:
#
#   cp "$ZDOTDIR/secrets.zsh.example" "$ZDOTDIR/secrets.zsh"
#   chmod 600 "$ZDOTDIR/secrets.zsh"
#
# secrets.zsh is gitignored; this .example file is the tracked copy and must
# never hold a real value. .zshrc sources secrets.zsh only if it exists, so a
# machine without one still starts a clean shell.

# ---------- OpenAI ----------
export OPENAI_API_KEY=""
